JWT_SECRET=change-me-to-a-long-random-string
DB_DSN=mume:mume@tcp(mysql:3306)/mume?parseTime=true&multiStatements=true&charset=utf8mb4
PUBLIC_URL=https://api.example.com

# Storage: Cloudflare R2 / AWS S3 (leave empty to store files on local disk under DATA_DIR)
# Cloudflare R2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=
R2_CUSTOM_DOMAIN=   # e.g. https://media.example.com (or pub-xxx.r2.dev)

# Or generic S3 / AWS S3 / MinIO:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET=
# S3_BUCKET=
# S3_CUSTOM_DOMAIN=https://cdn.example.com

# YouTube worker (node-yt); must match its INTERNAL_KEY
NODE_YT_URL=http://node-yt:3000
NODE_YT_KEY=change-me-too

# First admin account, created on startup if missing
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
